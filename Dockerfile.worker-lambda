FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN ./node_modules/.bin/esbuild src/worker/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.js

FROM public.ecr.aws/lambda/nodejs:22
COPY --from=builder /app/dist/lambda.js ${LAMBDA_TASK_ROOT}/lambda.js
CMD ["lambda.handler"]
