FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN ./node_modules/.bin/esbuild src/worker/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.js

FROM public.ecr.aws/lambda/nodejs:22
RUN dnf install -y --releasever 2023.12.20260831 \
      openssl-snapsafe-libs-3.5.7-2.amzn2023.0.2 \
      openssl-fips-provider-latest-3.5.7-2.amzn2023.0.2 \
    && dnf clean all
COPY --from=builder /app/dist/lambda.js ${LAMBDA_TASK_ROOT}/lambda.js
CMD ["lambda.handler"]
